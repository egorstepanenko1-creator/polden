generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Kitchen economics v1 (see docs/KITCHEN_ECONOMICS_V1_SPEC.md) ---

model Unit {
  id          String @id @default(cuid())
  code        String @unique
  displayName String

  ingredientsDefault  Ingredient[]       @relation("IngredientDefaultUnit")
  ingredientPrices    IngredientPrice[]
  dishIngredientLines DishIngredient[]
  stockMovements      StockMovement[]
  supplierOffers      SupplierIngredientOffer[]
  purchaseDraftLines  PurchaseDraftLine[]
  inventoryCountLines InventoryCountLine[]
}

model Ingredient {
  id            String  @id @default(cuid())
  name          String
  sku           String?
  active        Boolean @default(true)
  defaultUnitId String
  defaultUnit   Unit    @relation("IngredientDefaultUnit", fields: [defaultUnitId], references: [id])

  prices    IngredientPrice[]
  dishLines DishIngredient[]
  stockMovements StockMovement[]
  supplierOffers SupplierIngredientOffer[]
  purchaseDraftLines PurchaseDraftLine[]
  inventoryCountLines InventoryCountLine[]
}

/// Supplier foundation v1 ??? ?????? ??????????????/??????????????; ???????????? ???????????????????? ?? ?????????????? ????????????.
model Supplier {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers             SupplierIngredientOffer[]
  purchaseDraftLines PurchaseDraftLine[]
}

/// ???????????????? ?? ????????????????????: ???????? ???? ???????????????? ?? ????????????????; ???????????????? ???????????????? [effectiveFrom, effectiveTo) ???????? effectiveTo ??????????.
model SupplierIngredientOffer {
  id                 String    @id @default(cuid())
  supplierId         String
  supplier           Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ingredientId       String
  ingredient         Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unitId             String
  unit               Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  packQuantity       Decimal
  pricePerPackKopeks Int
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  note               String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([supplierId])
  @@index([ingredientId, unitId, effectiveFrom])
}

/// Price per one `unitId` in kopeks; time-bounded (spec: validFrom/validTo ??? effectiveFrom/effectiveTo).
model IngredientPrice {
  id                 String    @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  unitId             String
  unit               Unit        @relation(fields: [unitId], references: [id])
  pricePerUnitKopeks Int
  effectiveFrom      DateTime
  effectiveTo        DateTime?

  @@index([ingredientId, unitId, effectiveFrom])
}

model Dish {
  id        String  @id @default(cuid())
  name      String
  active    Boolean @default(true)
  category  String?
  salePrice Int?
  versions  DishVersion[]
}

model DishVersion {
  id            String   @id @default(cuid())
  dishId        String
  dish          Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  versionNumber Int
  /// draft | published
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  lines         DishIngredient[]
  menuDayItems  MenuDayItem[]

  @@unique([dishId, versionNumber])
}

model DishIngredient {
  id            String      @id @default(cuid())
  dishVersionId String
  dishVersion   DishVersion @relation(fields: [dishVersionId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id])
  quantity      Decimal
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id])

  @@index([dishVersionId])
}

// --- Existing CRM (ordering) ---

model Branch {
  id        String            @id @default(cuid())
  name      String
  orders    DeliveryOrder[]
  menuItems MenuDayItem[]
  stockMovements StockMovement[]
  purchaseDrafts PurchaseDraft[]
  inventoryCountBatches InventoryCountBatch[]
  productionWriteoffBatches ProductionWriteoffBatch[]
  companyAccountsDefault    CompanyAccount[] @relation("CompanyDefaultBranch")
  orderWindows              OrderWindow[]
}

/// ???????? ???????????? ??????????????: ???? openedAt ???? closesAt (deliveryDate 06:00 ??????).
/// ???????? now < closesAt ??? ???????????? ??????????????????????. ?????????? ??? ?????????????????????????? ??????????????.
model OrderWindow {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deliveryDate String
  openedAt     DateTime @default(now())
  /// ????????-????????????????: deliveryDate 06:00 Asia/Yekaterinburg. ???????????????? ?????????? ?????????????? ????????????.
  closesAt     DateTime
  /// ???????? ???????????????? ?????????????? ???????????? ????????????
  manuallyClosed Boolean @default(false)

  @@unique([branchId, deliveryDate])
}

/// B2B: ???????????????? (???????? / ??????????????), ???????? ?????????????? ?????????? ????????????????.
model CompanyAccount {
  id                String   @id @default(cuid())
  companyName       String
  city              String
  address           String
  notes             String?
  /// NEW | ACTIVE | PAUSED | LOST
  status            String   @default("NEW")
  defaultBranchId   String?
  defaultBranch     Branch?  @relation("CompanyDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  contacts          CompanyContact[]
  corporateLeads    CorporateLead[]
  deliveryOrders    DeliveryOrder[]

  @@index([status])
  @@index([city])
}

model CompanyContact {
  id                     String         @id @default(cuid())
  companyAccountId       String
  companyAccount         CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  name                   String
  phone                  String
  roleTitle              String?
  preferredContactMethod String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([companyAccountId])
}

/// ???????????? ???? ?????????????????????????? ?????????? (??????), ???? ?? ?????????? ???????????????? ?? CompanyAccount.
model CorporateLead {
  id                    String          @id @default(cuid())
  companyAccountId      String?
  companyAccount        CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: SetNull)
  contactName           String
  phone                 String
  companyName           String
  city                  String
  address               String
  headcountEstimate     Int?
  preferredDeliveryTime String?
  comment               String?
  /// SITE | VK | MANUAL | PHONE
  sourceChannel         String          @default("SITE")
  /// NEW | CONTACTED | QUOTED | PILOT | ACTIVE | LOST (ACTIVE = ???????????????????????????? ?? ????????????????)
  status                String          @default("NEW")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status])
  @@index([city])
  @@index([companyAccountId])
  @@index([createdAt])
}

/// ???????????????? ?????????????? v1 ??? ???????????? purchase-need + ?????????????????? ???????????? ???? ???????????? sourceEvaluatedAt.
model PurchaseDraft {
  id                 String   @id @default(cuid())
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date               String
  /// DRAFT ??? ???????????????????????? ???????????????? ?? v1 (?????? ?????????????????? ??????????????)
  status             String   @default("DRAFT")
  note               String?
  sourceEvaluatedAt  DateTime
  /// NONE | RECEIVED_PARTIAL | RECEIVED_FULL ??? ???? ?????????????????????? ?????????????? ?? ?????????????? ????????????????
  receiptStatus      String   @default("NONE")
  lastReceivedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  lines              PurchaseDraftLine[]

  @@index([branchId, date])
}

/// ???????????? ??????????????????: ???????????????? ?????????????????????????? ?????? ?????????????????? (?????????????????? ???????????????? ???? ??????????????????????????).
model PurchaseDraftLine {
  id                     String   @id @default(cuid())
  purchaseDraftId        String
  purchaseDraft          PurchaseDraft @relation(fields: [purchaseDraftId], references: [id], onDelete: Cascade)
  ingredientId           String
  ingredient             Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unitId                 String
  unit                   Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  purchaseNeedQty        Decimal
  supplierId             String?
  supplier               Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// ???????????? ???? ?????????? ???? ???????????? ?????????????????? (?????? FK ??? ?????????? ?????????? ??????????????/??????????????).
  supplierOfferId        String?
  packQuantity           Decimal?
  pricePerPackKopeks     Int?
  estimatedPacksNeeded   Int?
  estimatedBuyCostKopeks Int?
  /// ???????????????????? ?????????????? ?? ?????????????? ???????????????? (?????????? ???????? RECEIPT ???? ?????????? ??????????????????)
  receivedBaseQtyTotal   Decimal  @default(0)
  createdAt              DateTime @default(now())

  @@index([purchaseDraftId])
}

/// Stock truth v1 ??? journal only; balance = ?? signed(quantity by movementType).
model StockMovement {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// OPENING_BALANCE | RECEIPT | ADJUSTMENT_IN | ADJUSTMENT_OUT | WASTE | PRODUCTION_CONSUMPTION
  movementType String
  /// Magnitude always positive; sign from movementType.
  quantity     Decimal
  occurredAt   DateTime
  note         String?
  createdAt    DateTime @default(now())

  @@index([branchId, ingredientId, occurredAt])
  @@index([branchId, occurredAt])

  /// ?????????? 1:1 ???? ?????????????? ???????????????????????????? (???????? ???????????????? ?????????????? ?????? ????????????).
  inventoryCountLine InventoryCountLine?
  productionWriteoffMovementLinks ProductionWriteoffMovementLink[]
}

/// ???????????? ???????????????????????????? v1 ??? ??????????; ?????????????? ????-???????????????? ???????????? ???? StockMovement.
model InventoryCountBatch {
  id                 String   @id @default(cuid())
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  /// ???????????? ???????????????? ???????????? (occurredAt ????????????????).
  reconciledAt       DateTime
  note               String?
  rowCount           Int
  changedLineCount   Int
  adjustmentInCount  Int
  adjustmentOutCount Int
  lines              InventoryCountLine[]

  @@index([branchId, reconciledAt])
}

/// ???????????? ???????????? ???? ???????????? ???????????? + ???????????? ???? ?????????????????? ???????????????? (???????? ????????).
model InventoryCountLine {
  id                    String              @id @default(cuid())
  inventoryCountBatchId String
  inventoryCountBatch   InventoryCountBatch @relation(fields: [inventoryCountBatchId], references: [id], onDelete: Cascade)
  ingredientId          String
  ingredient            Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unitId                String
  unit                  Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  systemBalanceQty      Decimal
  countedQty            Decimal
  differenceQty         Decimal
  movementType          String?
  adjustmentQty         Decimal?
  stockMovementId       String?             @unique
  stockMovement         StockMovement?      @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([inventoryCountBatchId])
}

model MenuDayItem {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date     String
  position Int
  name     String
  price    Int

  /// Optional link to published dish version; snapshot taken on protected upsert only.
  dishVersionId String?
  dishVersion   DishVersion? @relation(fields: [dishVersionId], references: [id], onDelete: SetNull)

  /// Frozen food cost (kopeks) at foodCostSnapshottedAt; null if no dishVersion linked.
  foodCostKopeksSnapshot Int?
  foodCostSnapshottedAt  DateTime?

  @@unique([branchId, date, position])
  productionWriteoffLines ProductionWriteoffLine[]
}

/// ???????????? ???????????????? ???? ???????????????????????? v1 ??? ??????????; ?????????????? ???????????? ???? StockMovement.
model ProductionWriteoffBatch {
  id                     String   @id @default(cuid())
  branchId               String
  branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  date                   String
  createdAt              DateTime @default(now())
  note                   String?
  affectedPositionsCount Int
  createdMovementCount   Int
  lines                  ProductionWriteoffLine[]
  movementLinks          ProductionWriteoffMovementLink[]

  @@index([branchId, date])
}

model ProductionWriteoffLine {
  id                        String                  @id @default(cuid())
  productionWriteoffBatchId String
  batch                     ProductionWriteoffBatch @relation(fields: [productionWriteoffBatchId], references: [id], onDelete: Cascade)
  menuDayItemId             String
  menuDayItem               MenuDayItem             @relation(fields: [menuDayItemId], references: [id], onDelete: Restrict)
  position                  Int
  writeoffQty               Decimal
  dishVersionId             String?
  createdAt                 DateTime                @default(now())

  @@index([productionWriteoffBatchId])
  @@index([menuDayItemId])
}

/// ?????????? ???????????? ???????????????? ?? ???????????????????? ???????????????????? PRODUCTION_CONSUMPTION.
model ProductionWriteoffMovementLink {
  id                        String                  @id @default(cuid())
  productionWriteoffBatchId String
  batch                     ProductionWriteoffBatch @relation(fields: [productionWriteoffBatchId], references: [id], onDelete: Cascade)
  stockMovementId           String                  @unique
  stockMovement             StockMovement           @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)

  @@index([productionWriteoffBatchId])
}

model DeliveryOrder {
  id              String              @id @default(cuid())
  branchId        String
  branch          Branch              @relation(fields: [branchId], references: [id])
  deliveryDate    String
  customerName    String
  customerPhone   String
  address         String?
  comment         String?
  paymentType     String?
  itemsSubtotalKopeks Int?
  deliveryFeeKopeks Int?
  totalAmount     Int
  /// NEW | CONFIRMED | KITCHEN | DELIVERING | DONE | CANCELED
  status          String              @default("NEW")
  /// SITE | VK | MANUAL | PHONE
  sourceChannel   String              @default("SITE")
  /// ???????????????????????????????? JSON ?????????????????? (UTM, ???????? ????????????????, referrer); null ???????? ???? ????????????????
  attributionJson String?
  companyAccountId String?
  companyAccount   CompanyAccount?    @relation(fields: [companyAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  items           DeliveryOrderItem[]
  leadConversion  VkLead?             @relation("VkLeadConvertedOrder")

  @@index([companyAccountId])
}

model DeliveryOrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   DeliveryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int
  qty     Int
}

/// ??????????????-???????????????? v1 (VK-first) ??? ???????????????????????? ???????????? ?? UTM; ???? ???????????????? ??????????????.
model ContentItem {
  id           String    @id @default(cuid())
  title        String
  /// VK | ???
  channel      String    @default("VK")
  contentType  String    @default("post")
  /// IDEA | DRAFT | APPROVED | PUBLISHED
  status       String    @default("IDEA")
  publishDate  DateTime?
  captionDraft String    @default("")
  creativeNote String?
  landingPath  String?
  targetUrl    String?
  utmSource    String    @default("vk")
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  generatedUrl String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  launchDrillRecords LaunchDrillRecord[]

  @@index([status])
  @@index([channel])
  @@index([publishDate])
}

/// ???????????? ???????????????????? drill: ???????????????? content ??? URL ??? ?????????? ??? performance (??????????, ?????? ??????????????????????????).
model LaunchDrillRecord {
  id                         String      @id @default(cuid())
  contentItemId              String
  contentItem                ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  expectedGeneratedUrl       String
  /// JSON: { code, effectiveOrigin, isSafeForPublish } ???? ???????????? ????????????
  originStatusAtRun          String
  /// STARTED ??? ?????????? SUCCESS | FAILED | PARTIAL
  runStatus                  String      @default("STARTED")
  startedAt                  DateTime    @default(now())
  completedAt                DateTime?
  observedOrderId            String?
  observedRevenueKopeks      Int?
  observedAttributionSummary String?
  note                       String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@index([contentItemId])
  @@index([startedAt])
}


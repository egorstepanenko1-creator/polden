/// ?????? ???? VK-???????? ??? ???? ??????????; ???????????????? ?????????????????? DeliveryOrder ????????????????.
model VkLead {
  id                   String          @id @default(cuid())
  source               String          @default("vk_bot")
  channel              String          @default("vk")
  vkUserId             String
  peerId               String
  name                 String
  phone                String
  address              String
  requestedDateText    String
  comment              String          @default("")
  status               String          @default("NEW")
  rawPayloadJson       String
  menuContentItemId    String?
  attributionCampaign  String?
  convertedOrderId     String?         @unique

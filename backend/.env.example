# SQLite: относительный путь в file: — от каталога prisma/ (не от cwd процесса).
# Пример: file:./dev.db  →  <backend>/prisma/dev.db
# Для продакшена без двусмысленности используйте абсолютный file:/var/lib/polden/app.db
DATABASE_URL="file:./dev.db"

# NODE_ENV=production или POLDEN_STRICT_DB_CHECK=1: не стартовать, если в Branch 0 строк (пустая/чужая БД).
# Первый деплой до seed: POLDEN_ALLOW_EMPTY_DB=1
# POLDEN_ALLOW_EMPTY_DB=
# POLDEN_STRICT_DB_CHECK=

# GET /health: добавить sqliteAbsPath и branchCount
# POLDEN_HEALTH_DETAIL=

PORT=4000
CRM_INTERNAL_TOKEN=dev
# Production-like (NODE_ENV=production или POLDEN_PRODUCTION_LIKE=1): см. docs/PUBLIC_ORDER_HARDENING.md
# POLDEN_PRODUCTION_LIKE=
# POLDEN_ALLOW_DEV_CRM_TOKEN=1   # только осознанно: CRM_INTERNAL_TOKEN=dev
# POLDEN_ALLOW_EMPTY_VK_WEBHOOK_SECRET=1   # dev: пустой VK secret (в проде не использовать)

# За прокси (nginx) для корректного req.ip в rate limit:
# POLDEN_TRUST_PROXY=1

# Rate limit публичных POST quote/create (in-memory):
# PUBLIC_ORDER_RATE_WINDOW_MS=60000
# PUBLIC_ORDER_QUOTE_RATE_MAX=45
# PUBLIC_ORDER_CREATE_RATE_MAX=25

# CORS в production-like: список origin через запятую ИЛИ PUBLIC_SITE_ORIGIN / CRM_FRONTEND_ORIGIN(S)
# POLDEN_CORS_ORIGINS=https://site.example,https://crm.example
# Зарезервировано под будущую CAPTCHA (сейчас не используется):
# POLDEN_PUBLIC_CAPTCHA_MODE=off
# Реальный origin публичного сайта для ссылок контент-пайплайна (landingPath + UTM).
# Если не задан или невалиден — в ссылке будет заглушка https://example.invalid (CRM покажет предупреждение).
# Для локального VK drill меню: http://localhost:5173 (Vite). Для прода — реальный https сайта.
PUBLIC_SITE_ORIGIN=https://example.com
# Origin CRM (Vite); в production-like учитывается в CORS вместе с PUBLIC_SITE_ORIGIN, если задан:
# CRM_FRONTEND_ORIGIN=http://localhost:5173

# --- VK Callback / бот (лиды) ---
# Секрет из настроек Callback в VK; код подтверждения сервера (строка из диалога VK).
VK_WEBHOOK_SECRET=
VK_CALLBACK_CONFIRMATION_CODE=
# Токен сообщества с правом messages (messages.send).
VK_GROUP_ACCESS_TOKEN=
# Текст для кнопки «Связаться с оператором» (опционально).
VK_OPERATOR_CONTACT_TEXT=

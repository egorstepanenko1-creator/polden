DATABASE_URL="file:./dev.db"
PORT=4000
CRM_INTERNAL_TOKEN=dev
# Реальный origin публичного сайта для ссылок контент-пайплайна (landingPath + UTM).
# Если не задан или невалиден — в ссылке будет заглушка https://example.invalid (CRM покажет предупреждение).
# Для локального VK drill меню: http://localhost:5173 (Vite). Для прода — реальный https сайта.
PUBLIC_SITE_ORIGIN=https://example.com

# --- VK Callback / бот (лиды) ---
# Секрет из настроек Callback в VK; код подтверждения сервера (строка из диалога VK).
VK_WEBHOOK_SECRET=
VK_CALLBACK_CONFIRMATION_CODE=
# Токен сообщества с правом messages (messages.send).
VK_GROUP_ACCESS_TOKEN=
# Текст для кнопки «Связаться с оператором» (опционально).
VK_OPERATOR_CONTACT_TEXT=

# X-CRM-Token для защищённых маршрутов /api (должен совпадать с CRM_INTERNAL_TOKEN на backend).
# Пусто → в api.js подставляется значение по умолчанию 'dev'.
VITE_CRM_TOKEN=

# Абсолютный origin API (без /api в конце). Пусто → запросы идут на /api относительно dev-сервера (прокси Vite).
# Прямой прод: https://api.example.com (нужен CORS на backend для origin Vite).
VITE_API_BASE=

# Куда проксировать /api в dev-сервере Vite (если VITE_API_BASE пустой).
# Пусто или не задано → http://localhost:4000 (см. vite.config.js).
VITE_DEV_API_PROXY_TARGET=
